# Lunex server-side identification for NASA/JPL Horizons requests.
# Replace the contact placeholder with a team-managed public contact address.
HORIZONS_USER_AGENT=Lunex/1.0 (contact: your-team-email)

# Optional public Moon model asset URL.
# Leave blank to use the application's configured local default path.
NEXT_PUBLIC_LUNEX_MOON_MODEL_URL=
